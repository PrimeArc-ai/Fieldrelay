# Copy to .env. Never commit real keys.

FIELDRELAY_ENV=poc
DATABASE_URL=sqlite:///./backend/data/fieldrelay.db
CORS_ORIGINS=http://localhost:3000

# Demo ZIP coverage (fictional)
SUPPORTED_ZIPS=560001,560002,560003,560004

# Vapi — browser voice on Start Demo Call.
# Public key is required for the assistant to speak.
# Optional assistant ID from the Vapi dashboard; if omitted, a FieldRelay POC assistant config is used.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
